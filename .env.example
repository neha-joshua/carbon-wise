# Copy this file to ".env" (same folder) and fill in your real key.
# NEVER commit the real ".env" file to GitHub -- it's already in .gitignore.
#
# Without this file (or with it left blank), CarbonWise works completely
# normally using its rule-based explanation engine -- the AI layer is a
# pure optional upgrade, not a requirement.

OPENAI_API_KEY=

# Optional: override the default model (gpt-4o-mini is cheap and sufficient
# for this task -- fractions of a cent per explanation generated).
# CARBONWISE_LLM_MODEL=gpt-4o-mini
